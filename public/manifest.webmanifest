{
  "name": "rrstudio tools",
  "short_name": "rr tools",
  "description": "Strumenti online gratuiti che funzionano nel browser: i tuoi file non vengono mai caricati. Free online tools that run in your browser.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f6f3",
  "theme_color": "#4f46e5",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/condividi/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf", "text/*", ".csv", ".tsv", ".json", ".yaml", ".yml", ".xml", ".svg", ".pem", ".crt", ".cer", ".md", ".txt"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/condividi/",
      "accept": {
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"],
        "image/avif": [".avif"],
        "image/svg+xml": [".svg"],
        "application/pdf": [".pdf"],
        "text/csv": [".csv"],
        "text/tab-separated-values": [".tsv"],
        "application/json": [".json"],
        "application/yaml": [".yaml", ".yml"],
        "application/xml": [".xml"],
        "text/xml": [".xml"],
        "application/x-pem-file": [".pem"],
        "application/x-x509-ca-cert": [".crt", ".cer"],
        "text/plain": [".txt", ".md"]
      }
    }
  ]
}
